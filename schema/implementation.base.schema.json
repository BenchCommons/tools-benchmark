{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BenchCommons/tools-benchmark/master/schema/implementation.base.schema.json",
  "title": "Implementation metadata, base fields (catalog contract, spec 010 R-10)",
  "type": "object",
  "required": ["id", "name", "language", "benchmark"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "license": {"type": "string"},
    "homepage": {"type": "string"},
    "repository": {"type": "string"},
    "benchmark": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["active", "wip", "removed"]}}
    },
    "platforms": {
      "type": "array",
      "items": {"enum": ["linux/amd64", "linux/arm64"]}
    }
  }
}
